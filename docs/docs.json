{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Malibu",
  "description": "Distributed Apple Silicon inference network — verifiable, OpenAI-compatible, USDC-settled.",
  "colors": {
    "primary": "#143A45",
    "light": "#F76B57",
    "dark": "#143A45"
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo-light.svg",
    "dark": "/logo-dark.svg",
    "href": "https://malibu.tech"
  },
  "appearance": {
    "default": "system"
  },
  "navbar": {
    "links": [
      { "label": "Console", "href": "https://malibu.tech/console" },
      { "label": "Host", "href": "https://malibu.tech/host" }
    ],
    "primary": {
      "type": "button",
      "label": "Download",
      "href": "https://malibu.tech/host"
    }
  },
  "anchors": [
    {
      "name": "GitHub",
      "icon": "github",
      "url": "https://github.com/MalibuAI/malibu"
    },
    {
      "name": "Network",
      "icon": "chart-line",
      "url": "https://malibu.tech/network"
    }
  ],
  "redirects": [
    { "source": "/", "destination": "/litepaper" }
  ],
  "navigation": {
    "groups": [
      {
        "group": "Litepaper",
        "pages": ["litepaper"]
      },
      {
        "group": "Getting started",
        "pages": [
          "getting-started/introduction",
          "getting-started/download-malibu",
          "getting-started/agent-onboarding",
          "getting-started/api-key"
        ]
      },
      {
        "group": "Buyers",
        "pages": [
          "api/chat-completions",
          "api/models",
          "api/headers",
          "api/usage-object",
          "api/network-stats",
          "guides/openai-sdk",
          "guides/receipts",
          "guides/sticky-conversations",
          "guides/pinning",
          "guides/pricing-comparison",
          "guides/tool-calling-and-structured-output",
          "agentic/tool-calling",
          "agentic/structured-output",
          "agentic/buyer-side-validation"
        ]
      },
      {
        "group": "Providers",
        "pages": [
          "guides/payments",
          "guides/economics",
          "guides/provider-economics",
          "cli/malibu-cli",
          "cli/malibu-verify",
          "cli/headless-install",
          "cli/flags-and-config",
          "operations/model-catalog",
          "operations/verified-model-settlement",
          "operations/provider-autoupdate"
        ]
      },
      {
        "group": "Network & trust",
        "pages": [
          "network/overview",
          "network/security",
          "network/threat-model",
          "network/receipts",
          "network/toploc",
          "network/benchmarks-and-methodology",
          "network/glossary",
          "network/metering-and-billing",
          "network/discovery-and-routing",
          "network/transport",
          "network/reputation",
          "operations/network-stats"
        ]
      },
      {
        "group": "Guides index",
        "pages": ["guides/index"]
      },
      {
        "group": "Ledger",
        "pages": ["status", "roadmap", "changelog"]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/MalibuAI/malibu"
    }
  }
}
